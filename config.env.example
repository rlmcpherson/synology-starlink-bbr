# Copy to config.env and edit. All scripts read it.

# NAS SSH access. An administrator account with passwordless sudo.
NAS_HOST=192.168.1.10
NAS_SSH_PORT=22
NAS_USER=admin
# NAS address on the LAN. HAProxy forwards here.
NAS_LAN_IP=192.168.1.10

# Set to 1 when you can reach the NAS but not the VM directly (e.g. NAS_HOST is a public
# address and you are off-site). Needs SynoCommunity's synocli-net package for nc.
VM_VIA_NAS=${VM_VIA_NAS:-0}
NAS_NC=/var/packages/synocli-net/target/bin/nc

# Shared folder path on the NAS for the VM images. VMM reads the seed ISO in place from here.
NAS_IMAGE_DIR=/volume1/homes/admin/starlink-proxy

# Debian cloud image. "generic" is tested with VMM's legacy BIOS and IDE disk.
DEBIAN_IMAGE_URL=https://cloud.debian.org/images/cloud/trixie/latest
DEBIAN_IMAGE=debian-13-generic-amd64

# Proxy VM. VM_HOSTNAME is also the VM name in VMM.
VM_HOSTNAME=starlink-proxy
# Must not be a Debian system account such as "proxy", or cloud-init reuses it with a nologin shell.
VM_USER=${VM_USER:-ops}
# A free address outside your DHCP pool, or reserved for the VM on your router.
VM_IP=${VM_IP:-192.168.1.254}
# Your LAN. Used to compute Plex's LAN Networks setting.
LAN_CIDR=192.168.1.0/24

# Services to proxy, space separated: name:port or name:listen_port:nas_port.
# Forward each port on your router to VM_IP instead of the NAS.
SERVICES=${SERVICES:-plex:32400}

# Public hostname or IP that remote clients use. Used by bench/ab-test.sh.
PUBLIC_HOST=nas.example.net
